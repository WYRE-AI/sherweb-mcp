# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
SHERWEB_CLIENT_ID=
SHERWEB_CLIENT_SECRET=
SHERWEB_SUBSCRIPTION_KEY=

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-Sherweb-Client-ID, X-Sherweb-Client-Secret, and
#          X-Sherweb-Subscription-Key on each /mcp request.
#          Never falls back to SHERWEB_* . Docker image and Compose default.
# env:     use SHERWEB_* after X-Gateway-S2S verifies.
# AUTH_MODE=gateway

# Required to start the HTTP transport. Leave this empty here.
# The process logs an error and exits non-zero when this is empty or a known
# placeholder (changeme, your-s2s-secret, placeholder, secret, and similar),
# so a copied example cannot forge X-Gateway-S2S. Compose will not start when
# it is unset or empty. Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0. A known placeholder
# secret is still refused. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1 when unset.
# The container image sets 0.0.0.0. Without a real secret the listener is
# 127.0.0.1 regardless of this value.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
